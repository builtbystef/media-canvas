{
  "name": "worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/index.ts",
    "environment:write": "node src/write-environment.ts",
    "image:build": "docker build --file Dockerfile --tag media-canvas-worker:pinned ../..",
    "image:check": "pnpm run image:build && docker run --rm media-canvas-worker:pinned bash -c 'node --test apps/worker/src/checks/*.check.ts'"
  },
  "dependencies": {
    "@media-canvas/core": "workspace:*",
    "playwright-core": "catalog:"
  },
  "devDependencies": {
    "@media-canvas/fonts": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
