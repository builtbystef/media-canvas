{
  // Runtime-neutral strictness shared by every workspace project.
  // Projects don't extend this directly — they extend an environment preset
  // from this folder (node.json, browser.json, library.json).
  "compilerOptions": {
    "target": "ES2024",
    "module": "preserve",

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,

    // Workspace packages export TypeScript source, and Node runs it by
    // stripping types — so a relative import inside a package carries its
    // `.ts` extension, exactly as Node's ESM resolver requires. Every project
    // here sets noEmit, which is what this option needs.
    "allowImportingTsExtensions": true,

    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  }
}
