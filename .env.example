# Media Canvas environment.
#
#   cp .env.example .env
#
# Then fill in every value marked required below; that is the whole setup.
# `.env` is git-ignored and is the file `docker compose` reads. The same file
# is what a deployer fills in on a server.
#
# Generate every secret value with:
#
#   openssl rand -hex 32

# Postgres -------------------------------------------------------------------

# required — the password for the media_canvas database user and database.
POSTGRES_PASSWORD=

# Object storage (Garage) ----------------------------------------------------

# required — the S3 credential. Garage mints an access key from this pair on
# first boot, and the api and the worker authenticate with the same pair.
# The access key is an identifier, so any short string will do; the secret key
# is a secret, and Garage rejects one shorter than 16 characters.
GARAGE_DEFAULT_ACCESS_KEY=
GARAGE_DEFAULT_SECRET_KEY=

# required — the node-to-node RPC secret, exactly 32 bytes of hex. A single
# node never uses it, but Garage refuses to start without one.
GARAGE_RPC_SECRET=

# optional — where the api reaches object storage over the S3 API, and the
# region it signs its requests for. The defaults are the Garage the compose
# file starts; a deployment on hosted object storage points them elsewhere,
# and nothing else about the api changes.
STORAGE_ENDPOINT=http://localhost:3900
STORAGE_REGION=garage

# Sandboxed coding agents cannot reach localhost TCP (their sandbox isolates
# the network namespace). Postgres and Redis also answer on unix sockets that
# compose publishes into .dev/run/ — psql "host=<repo>/.dev/run/pg", or
# redis-cli -s <repo>/.dev/run/redis/redis.sock. For Garage the sandbox's
# egress proxy works with the stack.local alias for 127.0.0.1 (one-time host
# setup: echo '127.0.0.1 stack.local' | sudo tee -a /etc/hosts):
#
#   STORAGE_ENDPOINT=http://stack.local:3900

# optional — the buckets the api creates on startup and holds bytes in. Assets
# are written once and kept; outputs belong to a Generation Job and are
# deleted with it.
ASSETS_BUCKET=media-canvas-assets
OUTPUTS_BUCKET=media-canvas-outputs

# Internal services ----------------------------------------------------------

# required — the credential the api and the render worker present to each
# other. It never leaves the stack: the api calls the worker to validate a
# batch or render a row, and the worker calls back to report results and to
# fetch asset bytes.
INTERNAL_API_TOKEN=

# optional — the port the worker's internal service listens on, and so the
# port the api reaches it at.
WORKER_INTERNAL_PORT=4000

# optional — the host the api reaches the worker at. The default is the
# development machine, where `pnpm dev` runs both; a compose deployment names
# the worker service instead.
WORKER_INTERNAL_HOST=localhost

# optional — where the worker reaches the api's internal routes (asset bytes).
# The default is the development machine; a compose deployment names the api
# service instead.
API_INTERNAL_URL=http://localhost:8000

# Redis (BullMQ work signal) ----------------------------------------------

# optional — where the api and the worker reach Redis. Defaults are the compose stack.
# Sandboxed agents cannot reach the loopback port; they use the unix socket
# compose publishes into .dev/run/redis:
#   REDIS_HOST=<repo>/.dev/run/redis/redis.sock
REDIS_HOST=localhost
REDIS_PORT=6379

# Where the product is reached ------------------------------------------------

# optional — the domain the stack is served on. Setting it is the whole of
# enabling HTTPS: the proxy obtains and renews the certificate itself. Leave
# it empty on a development machine, where the editor's own dev server is the
# address you open and the api answers it cross-origin.
DOMAIN=

# optional — the public HTTP port when DOMAIN is empty; defaults to 80. When
# DOMAIN is set, leave this at 80 so Caddy can answer the certificate challenge
# and redirect plain HTTP to HTTPS.
HTTP_PORT=80

# optional — the absolute base the product is reached at, for a deployment
# fronted by something other than this stack's own proxy. `DOMAIN` wins when
# both are set.
PUBLIC_URL=

# Mail ---------------------------------------------------------------------

# optional — which Mailer sends sign-in codes and Workspace Invites.
# `console` (the default) prints both to the api log, so an instance that
# sets nothing still signs people in offline. `resend` and `smtp` send real
# mail; a missing setting for the chosen driver fails startup naming it.
MAILER=console

# required when MAILER=resend — the Resend API key.
RESEND_API_KEY=

# required when MAILER=smtp — the submission host and the credentials it
# accepts. The port defaults to 587 (STARTTLS).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# required when MAILER is resend or smtp — the sender address both drivers use.
EMAIL_FROM=
