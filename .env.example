# Media Canvas environment.
#
#   cp .env.example .env
#
# Then fill in every value marked required below; that is the whole setup.
# `.env` is git-ignored and is the file `docker compose` reads. The same file
# is what a deployer fills in on a server.
#
# Generate every secret value with:
#
#   openssl rand -hex 32

# Postgres -------------------------------------------------------------------

# required — the password for the media_canvas database user and database.
POSTGRES_PASSWORD=

# Object storage (Garage) ----------------------------------------------------

# required — the S3 credential. Garage mints an access key from this pair on
# first boot, and the api and the worker authenticate with the same pair.
# The access key is an identifier, so any short string will do; the secret key
# is a secret, and Garage rejects one shorter than 16 characters.
GARAGE_DEFAULT_ACCESS_KEY=
GARAGE_DEFAULT_SECRET_KEY=

# required — the node-to-node RPC secret, exactly 32 bytes of hex. A single
# node never uses it, but Garage refuses to start without one.
GARAGE_RPC_SECRET=
