{
  "extends": "../../tsconfig/browser.json",
  "compilerOptions": {
    "jsx": "preserve",
    // The generated @media-canvas/api-client runtime is compiled as part of this app
    // (transpilePackages) and doesn't satisfy exactOptionalPropertyTypes.
    "exactOptionalPropertyTypes": false,
    "allowJs": true,
    "noEmit": true,
    "incremental": true,
    "plugins": [{ "name": "next" }],
    // shadcn/ui components import through this alias, as its registry writes them.
    "paths": { "@/*": ["./*"] }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules", ".next"]
}
