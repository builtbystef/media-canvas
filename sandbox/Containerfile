# The agent sandbox image for media-canvas. Build it and run it only through
# sandbox/start.sh. Everything installed here is reachable only from inside
# the sandbox.
#
# The infrastructure stack (postgres, redis, garage) is NOT in this image and
# never runs inside the sandbox: a container-control socket is host root with
# another name, so it stays out. Start the stack on the host with
# `docker compose up -d`; start.sh joins the host network, so the sandbox
# reaches it at the same localhost URLs the host uses.

# The tracker CLI. A Go binary built here and copied in, so the sandbox needs
# no Go toolchain. Pinned to beaver-backlog origin/main as of 2026-08-17 —
# bump this by hand when the tracker moves.
FROM docker.io/library/golang:1.26-bookworm AS beaver
ENV CGO_ENABLED=0
RUN go install github.com/builtbystef/beaver-backlog/cmd/beaver@ef48f10b32416667ce1e7d0475c5b9bc4c80d00e

FROM docker.io/library/ubuntu:24.04

# postgresql-client and redis-tools talk to the host stack; the rest is the
# ordinary build toolchain. xz-utils unpacks the pinned Node tarball below.
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        git \
        curl \
        ca-certificates \
        build-essential \
        ripgrep \
        jq \
        xz-utils \
        unzip \
        less \
        procps \
        postgresql-client \
        redis-tools \
    && rm -rf /var/lib/apt/lists/*

# Node from the version this repository pins (.nvmrc), not from apt.
ARG NODE_VERSION=24.18.0
RUN curl -fsSL "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.xz" -o /tmp/node.tar.xz && \
    tar -xJf /tmp/node.tar.xz -C /usr/local --strip-components=1 && \
    rm /tmp/node.tar.xz

# pnpm and uv at the versions the repository pins (packageManager,
# tool.uv.required-version).
ARG PNPM_VERSION=11.17.0
RUN npm install -g "pnpm@${PNPM_VERSION}"
ARG UV_VERSION=0.12.3
RUN curl -fsSL "https://astral.sh/uv/${UV_VERSION}/install.sh" | env UV_INSTALL_DIR=/usr/local/bin sh

# The interpreter apps/api requires (.python-version). It lives outside the
# container home, so it survives independently of the state volume.
ENV UV_PYTHON_INSTALL_DIR=/opt/uv-python
RUN uv python install 3.14 && chmod -R a+rX /opt/uv-python

# Chromium's system libraries, so `playwright install chromium` works inside
# the sandbox once the render worker exists. Playwright resolves the package
# list for this distribution itself; the browser binaries themselves are not
# baked in — they land in the state volume on first install.
RUN npx --yes playwright install-deps chromium && rm -rf /var/lib/apt/lists/* /root/.npm

COPY --from=beaver /go/bin/beaver /usr/local/bin/beaver

RUN npm install -g @anthropic-ai/claude-code
RUN npm install -g @openai/codex
RUN npm install -g --ignore-scripts @earendil-works/pi-coding-agent

# The sandbox runs as a user without privileges: agent CLIs (Claude Code,
# Codex) refuse their full-permission flags under root. The uid 1000 also
# agrees with the host user, through the runtime's userns/user flag, so that
# /workspace stays the host user's property.
RUN userdel -r ubuntu 2>/dev/null || true; \
    useradd --create-home --uid 1000 --shell /bin/bash agent
USER agent

WORKDIR /workspace
